{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greywake.local/update-greywake-payload.schema.json",
  "title": "Greywake Update Payload",
  "type": "object",
  "required": ["session", "events"],
  "additionalProperties": false,
  "properties": {
    "session": {
      "type": "object",
      "required": ["id", "source", "captured_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"const": "live-play-chat"},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary", "status", "knowledge", "obsidian", "site"],
        "additionalProperties": false,
        "properties": {
          "summary": {"type": "string", "minLength": 1},
          "status": {"enum": ["revealed", "provisional", "canon"]},
          "knowledge": {
            "type": "object",
            "required": ["marek", "odie", "velmira"],
            "additionalProperties": false,
            "properties": {
              "marek": {"enum": ["known", "partial", "unknown"]},
              "odie": {"enum": ["known", "partial", "unknown"]},
              "velmira": {"enum": ["known", "partial", "unknown"]}
            }
          },
          "obsidian": {
            "type": "object",
            "required": ["write", "targets", "private_text"],
            "additionalProperties": false,
            "properties": {
              "write": {"type": "boolean"},
              "targets": {"type": "array", "items": {"type": "string"}},
              "private_text": {"type": "string"}
            }
          },
          "site": {
            "type": "object",
            "required": ["publish", "targets", "player_text"],
            "additionalProperties": false,
            "properties": {
              "publish": {"type": "boolean"},
              "targets": {"type": "array", "items": {"type": "string"}},
              "player_text": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
